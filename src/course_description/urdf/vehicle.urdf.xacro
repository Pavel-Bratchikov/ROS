<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="wheelbase" default="0.8"/>
  <xacro:arg name="track" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="half_base" value="${float('$(arg wheelbase)') / 2}"/>
  <xacro:property name="half_track" value="${float('$(arg track)') / 2}"/>
  <xacro:property name="tire_radius" value="${float('$(arg wheel_radius)')}"/>
  <xacro:property name="tire_width" value="0.07"/>
  <xacro:property name="sensor_mount" value="0.28 0 0.38"/>
  <xacro:property name="sensor_mass" value="${0.1 / 3}"/>

  <material name="chassis"><color rgba="0.11 0.43 0.67 1"/></material>
  <material name="tire"><color rgba="0.10 0.10 0.12 1"/></material>
  <material name="hub"><color rgba="0.62 0.64 0.68 1"/></material>
  <material name="camera"><color rgba="0.24 0.69 0.51 1"/></material>
  <material name="lidar"><color rgba="0.96 0.54 0.16 1"/></material>
  <material name="imu"><color rgba="0.60 0.31 0.73 1"/></material>

  <xacro:macro name="pose" params="xyz rotation">
    <origin xyz="${xyz}" rpy="${rotation}"/>
  </xacro:macro>

  <xacro:macro name="prism" params="name dimensions mass center surface">
    <xacro:property name="dimensions_si" value="${[float(component) for component in dimensions.split()]}"/>
    <xacro:property name="length" value="${dimensions_si[0]}"/>
    <xacro:property name="width" value="${dimensions_si[1]}"/>
    <xacro:property name="height" value="${dimensions_si[2]}"/>
    <link name="${name}">
      <visual>
        <xacro:pose xyz="${center}" rotation="0 0 0"/>
        <geometry><box size="${dimensions}"/></geometry>
        <material name="${surface}"/>
      </visual>
      <collision>
        <xacro:pose xyz="${center}" rotation="0 0 0"/>
        <geometry><box size="${dimensions}"/></geometry>
      </collision>
      <inertial>
        <xacro:pose xyz="${center}" rotation="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass * (width**2 + height**2) / 12}"
                 iyy="${mass * (length**2 + height**2) / 12}"
                 izz="${mass * (length**2 + width**2) / 12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="cylinder" params="name radius length mass center rotation surface">
    <xacro:property name="radial" value="${mass * (3 * radius**2 + length**2) / 12}"/>
    <link name="${name}">
      <visual>
        <xacro:pose xyz="${center}" rotation="${rotation}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${surface}"/>
      </visual>
      <collision>
        <xacro:pose xyz="${center}" rotation="${rotation}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <xacro:pose xyz="${center}" rotation="${rotation}"/>
        <mass value="${mass}"/>
        <inertia ixx="${radial}" iyy="${radial}" izz="${mass * radius**2 / 2}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="attach" params="name upstream downstream xyz rpy:='0 0 0'">
    <joint name="${name}" type="fixed">
      <parent link="${upstream}"/>
      <child link="${downstream}"/>
      <xacro:pose xyz="${xyz}" rotation="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="rolling_wheel" params="name upstream xyz">
    <xacro:cylinder name="${name}" radius="${tire_radius}" length="${tire_width}"
                    mass="0.8" center="0 0 0" rotation="${-pi / 2} 0 0" surface="tire"/>
    <joint name="${name}_joint" type="continuous">
      <parent link="${upstream}"/>
      <child link="${name}"/>
      <xacro:pose xyz="${xyz}" rotation="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="20"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="axle_side" params="side offset">
    <xacro:prism name="front_${side}_knuckle" dimensions="0.035 0.035 0.035"
                 mass="0.2" center="0 0 0" surface="hub"/>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <xacro:pose xyz="${half_base} ${offset} 0" rotation="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1"/>
    </joint>
    <xacro:rolling_wheel name="front_${side}_wheel" upstream="front_${side}_knuckle" xyz="0 0 0"/>
    <xacro:rolling_wheel name="rear_${side}_wheel" upstream="base_link" xyz="${-half_base} ${offset} 0"/>
  </xacro:macro>

  <link name="base_footprint"/>
  <xacro:prism name="base_link" dimensions="1.05 0.52 0.22" mass="12" center="0 0 0.12" surface="chassis"/>
  <xacro:attach name="base_joint" upstream="base_footprint" downstream="base_link" xyz="0 0 ${tire_radius}"/>
  <xacro:axle_side side="left" offset="${half_track}"/>
  <xacro:axle_side side="right" offset="${-half_track}"/>

  <xacro:prism name="camera_link" dimensions="0.08 0.06 0.04" mass="${sensor_mass}"
               center="0.04 0 0" surface="camera"/>
  <xacro:cylinder name="lidar_link" radius="0.035" length="0.04" mass="${sensor_mass}"
                  center="0 0 0.04" rotation="0 0 0" surface="lidar"/>
  <xacro:prism name="imu_link" dimensions="0.04 0.03 0.015" mass="${sensor_mass}"
               center="-0.05 0 0" surface="imu"/>
  <link name="camera_optical_frame"/>

  <xacro:attach name="camera_joint" upstream="base_link" downstream="camera_link" xyz="${sensor_mount}"/>
  <xacro:attach name="lidar_joint" upstream="base_link" downstream="lidar_link" xyz="${sensor_mount}"/>
  <xacro:attach name="imu_joint" upstream="base_link" downstream="imu_link" xyz="${sensor_mount}"/>
  <xacro:attach name="camera_optical_joint" upstream="camera_link" downstream="camera_optical_frame"
                xyz="0.08 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
</robot>
